{
  "format": "snek",
  "version": 2,
  "name": "Sports - basketball four factors (made-up league)",
  "nodes": [
    {
      "id": "1",
      "type": "input",
      "label": "Team box scores",
      "position": {
        "x": 0,
        "y": 60.0
      },
      "config": {
        "path": "examples/data/demo_sports/basketball_box.csv"
      }
    },
    {
      "id": "2",
      "type": "four_factors",
      "label": "",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "game": "game_id",
        "team": "team",
        "pts": "pts",
        "fgm": "fgm",
        "fga": "fga",
        "fg3m": "fg3m",
        "ftm": "ftm",
        "fta": "fta",
        "orb": "orb",
        "drb": "drb",
        "tov": "tov",
        "minutes": "minutes",
        "game_minutes": 40
      }
    },
    {
      "id": "4",
      "type": "shooting",
      "label": "Team shooting",
      "position": {
        "x": 300,
        "y": 120
      },
      "config": {
        "group_by": [
          "team"
        ],
        "pts": "pts",
        "fga": "fga",
        "fta": "fta",
        "fgm": "fgm",
        "fg3m": "fg3m",
        "fg3a": "fg3a"
      }
    }
  ],
  "edges": [
    {
      "id": "e1.out-2.in",
      "source": "1",
      "sourceHandle": "out",
      "target": "2",
      "targetHandle": "in"
    },
    {
      "id": "e1.out-4.in",
      "source": "1",
      "sourceHandle": "out",
      "target": "4",
      "targetHandle": "in"
    }
  ]
}