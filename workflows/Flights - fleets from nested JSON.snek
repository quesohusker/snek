{
  "format": "snek",
  "version": 2,
  "name": "Flights - fleets from nested JSON",
  "nodes": [
    {
      "id": "1",
      "type": "input",
      "label": "Carriers with fleets",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "path": "examples/data/nycflights13/carriers.json"
      }
    },
    {
      "id": "2",
      "type": "explode",
      "label": "One row per plane",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "column": "fleet"
      }
    },
    {
      "id": "3",
      "type": "unnest",
      "label": "Plane fields",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "column": "fleet",
        "prefix": false
      }
    },
    {
      "id": "4",
      "type": "filter",
      "label": "Known planes",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "mode": "basic",
        "column": "tailnum",
        "operator": "notna"
      }
    },
    {
      "id": "5",
      "type": "summarize",
      "label": "",
      "position": {
        "x": 1200,
        "y": 0
      },
      "config": {
        "group_by": [
          "name"
        ],
        "aggs": [
          {
            "column": "tailnum",
            "func": "count",
            "name": "planes"
          },
          {
            "column": "seats",
            "func": "mean",
            "name": "avg_seats"
          },
          {
            "column": "year",
            "func": "median",
            "name": "median_build_year"
          },
          {
            "column": "manufacturer",
            "func": "nunique",
            "name": "manufacturers"
          }
        ]
      }
    },
    {
      "id": "6",
      "type": "sort",
      "label": "",
      "position": {
        "x": 1500,
        "y": 0
      },
      "config": {
        "keys": [
          {
            "column": "planes",
            "order": "desc"
          }
        ],
        "nulls": "last"
      }
    }
  ],
  "edges": [
    {
      "id": "e1.out-2.in",
      "source": "1",
      "sourceHandle": "out",
      "target": "2",
      "targetHandle": "in"
    },
    {
      "id": "e2.out-3.in",
      "source": "2",
      "sourceHandle": "out",
      "target": "3",
      "targetHandle": "in"
    },
    {
      "id": "e3.out-4.in",
      "source": "3",
      "sourceHandle": "out",
      "target": "4",
      "targetHandle": "in"
    },
    {
      "id": "e4.true-5.in",
      "source": "4",
      "sourceHandle": "true",
      "target": "5",
      "targetHandle": "in"
    },
    {
      "id": "e5.out-6.in",
      "source": "5",
      "sourceHandle": "out",
      "target": "6",
      "targetHandle": "in"
    }
  ]
}